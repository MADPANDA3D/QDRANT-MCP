# Choose exactly one Docker Compose profile: standalone, standalone-request, or portal.
# All values here are placeholders. Never commit a populated .env file.
COMPOSE_PROFILES=
MCP_HOST_PORT=8000
MCP_RUNTIME_IMAGE=qdrant-mcp:local-source
MCP_BUILD_SHA=
MCP_SOURCE_FINGERPRINT=
MCP_IMAGE_VERSION=2.0.0-dev
# Add the reverse proxy's exact public Host when requests preserve it.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,qdrant-mcp-standalone:*,qdrant-mcp-standalone-request:*,qdrant-mcp-portal:*
# Leave browser origins empty unless exact trusted origins are deliberately enabled.
MCP_ALLOWED_ORIGINS=
MCP_REQUEST_BODY_MAX_BYTES=1048576
MCP_REQUEST_BODY_TIMEOUT_SECONDS=10

# Direct-Python credential mode. Compose fixes this from the selected profile.
MCP_ACCESS_TOKEN=
QDRANT_CREDENTIAL_MODE=server
QDRANT_URL=
QDRANT_API_KEY=

# Portal HTTP: broker grant plus request-scoped BYOK connector headers.
MCP_PORTAL_GRANT_TOKEN=
MCP_PORTAL_GRANT_HEADER=x-madpanda-portal-grant
MCP_TENANT_ID_HEADER=x-madpanda-user-id
MCP_QDRANT_HOST_ALLOWLIST=
MCP_QDRANT_ALLOWED_PORTS=443,6333
MCP_OPENAI_HOST_ALLOWLIST=api.openai.com
MCP_OPENAI_ALLOWED_PORTS=443
MCP_REQUIRE_REQUEST_COLLECTION=false
# Keep false to reuse the server's local FastEmbed default. If the server default is OpenAI,
# request/Portal startup requires true so a tenant can never consume the server OpenAI credential.
MCP_DISABLE_DEFAULT_EMBEDDING_FALLBACK=false
MCP_QDRANT_URL_HEADER=x-qdrant-url
MCP_QDRANT_API_KEY_HEADER=x-qdrant-api-key
MCP_COLLECTION_NAME_HEADER=x-collection-name
MCP_QDRANT_VECTOR_NAME_HEADER=x-qdrant-vector-name
MCP_EMBEDDING_PROVIDER_HEADER=x-embedding-provider
MCP_EMBEDDING_MODEL_HEADER=x-embedding-model
MCP_EMBEDDING_VECTOR_SIZE_HEADER=x-embedding-vector-size
MCP_OPENAI_API_KEY_HEADER=x-openai-api-key
MCP_OPENAI_BASE_URL_HEADER=x-openai-base-url
MCP_OPENAI_ORG_HEADER=x-openai-org
MCP_OPENAI_PROJECT_HEADER=x-openai-project

# Shared server-mode connector and embedding defaults. The standalone-request and Portal Compose
# profiles clear Qdrant plus server-owned OpenAI credential/endpoint fields but retain FastEmbed.
COLLECTION_NAME=
QDRANT_VECTOR_NAME=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=
EMBEDDING_VERSION=
# Direct Python only: leave both empty for normal FastEmbed acquisition. The stock image and
# Compose file fix these to the reviewed offline model and do not read overrides from this file.
FASTEMBED_MODEL_PATH=
FASTEMBED_MODEL_REVISION=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG=
OPENAI_PROJECT=

# Remote document/textbook fetches fail closed until hosts are explicitly listed.
# This is separate from the request-scoped Qdrant connector allowlist above.
MCP_OUTBOUND_HOST_ALLOWLIST=
MCP_OUTBOUND_ALLOWED_PORTS=443
MCP_ALLOW_INSECURE_OUTBOUND_HTTP=false

# Existing safety and resource controls. Tune deliberately for your deployment.
MCP_ADMIN_TOOLS_ENABLED=false
MCP_MUTATIONS_REQUIRE_ADMIN=false
MCP_MAX_BATCH_SIZE=500
MCP_MAX_POINT_IDS=500
MCP_STRICT_PARAMS=false
MCP_MAX_TEXT_LENGTH=8000
QDRANT_READ_ONLY=false
QDRANT_ALLOW_ARBITRARY_FILTER=false
QDRANT_SEARCH_LIMIT=10
MCP_QUERY_EMBEDDING_CACHE_SIZE=256
MCP_QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
MCP_DEDUPE_ACTION=update
MCP_INGEST_VALIDATION_MODE=allow
MCP_QUARANTINE_COLLECTION=quarantine
MCP_HEALTH_CHECK_COLLECTION=
MCP_SHORT_TERM_COLLECTION=short-term
MCP_STUDY_COLLECTION=study
MCP_SHORT_TERM_TTL_DAYS=7

# Document and textbook ingestion limits. Job state is ephemeral in the stock container.
MCP_TEXTBOOK_MAX_FILE_BYTES=262144000
MCP_FILE_UPLOAD_MAX_CHUNK_BYTES=524288
# These upload ceilings are per process/container, not fleet-wide.
MCP_FILE_UPLOAD_MAX_ACTIVE_PER_OWNER=4
MCP_FILE_UPLOAD_MAX_ACTIVE_GLOBAL=32
MCP_FILE_UPLOAD_MAX_AGGREGATE_BYTES_PER_OWNER=268435456
MCP_FILE_UPLOAD_MAX_AGGREGATE_BYTES_GLOBAL=536870912
MCP_TEXTBOOK_MAX_PAGES=5000
MCP_TEXTBOOK_MAX_EXTRACTED_CHARS=12000000
MCP_TEXTBOOK_MAX_CHUNKS=80000
MCP_TEXTBOOK_OCR_LOW_TEXT_THRESHOLD_CHARS=120
MCP_TEXTBOOK_OCR_MIN_COVERAGE_RATIO=0.85
MCP_TEXTBOOK_OCR_MAX_PAGES=120
MCP_TEXTBOOK_OCR_MAX_PAGE_RATIO=0.30
MCP_TEXTBOOK_JOB_TIMEOUT_SECONDS=7200
MCP_TEXTBOOK_EMBED_BATCH_SIZE=32
MCP_TEXTBOOK_UPSERT_BATCH_SIZE=64
MCP_TEXTBOOK_MAX_CONCURRENCY=2
MCP_TEXTBOOK_JOB_STATE_RETENTION_HOURS=168
# Background-job ceilings are also per process/container. The stock Compose /tmp is a 1 GiB
# ephemeral tmpfs shared with uploads, OCR intermediates, and other temporary runtime data.
MCP_BACKGROUND_JOB_MAX_ACTIVE_PER_OWNER=2
MCP_BACKGROUND_JOB_MAX_ACTIVE_GLOBAL=16
MCP_BACKGROUND_JOB_MAX_RETAINED_PER_OWNER=20
MCP_BACKGROUND_JOB_MAX_RETAINED_GLOBAL=100
MCP_BACKGROUND_JOB_LOG_MESSAGE_MAX_CHARS=512
MCP_BACKGROUND_JOB_MAX_LOGS_PER_JOB=100
MCP_BACKGROUND_JOB_MAX_LOG_TAIL=100
MCP_BACKGROUND_JOB_MAX_RESULT_BYTES=262144
MCP_BACKGROUND_JOB_MAX_RECORD_BYTES=524288
